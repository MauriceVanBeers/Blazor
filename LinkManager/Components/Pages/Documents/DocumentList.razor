@page "/dataitems/{id:int}/documents"

@using LinkManager.Data
@using LinkManager.Models
@inject ApplicationDbContext _context
@inject NavigationManager NavigationManager

<h3>Documents for Data Item @dataItem?.Name</h3>

@if (dataItem == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <p>
        <a href="@($"/dataitems/{dataItem.ID}/documents/create")">Add New Document</a>
    </p>
    @if(dataItem.DocumentList != null && dataItem.DocumentList.Documents != null)
    {
        <table class="table">
            <thead>
                <tr>
                    <th>Description</th>
                    <th>URL</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var doc in dataItem.DocumentList.Documents)
                {
                    <tr>
                        <td>@doc.Description</td>
                        <td><a href="@doc.Url" target="_blank">@doc.Url</a></td>
                        <td>
                            <a href="@($"/dataitems/{dataItem.ID}/documents/delete/{doc.ID}")">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

@code {
    [Parameter]
    public int id { get; set; }

    private DataItem dataItem = null!;

    protected override async Task OnInitializedAsync()
    {
        dataItem = await _context.DataItems
            .Include(d => d.DocumentList)
            .ThenInclude(dl => dl.Documents)
            .FirstOrDefaultAsync(m => m.ID == id);
    }
}