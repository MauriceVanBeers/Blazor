@page "/dataitems/{id:int}/documents/create"

@using LinkManager.Data
@using LinkManager.Models
@inject ApplicationDbContext _context
@inject NavigationManager NavigationManager

<h3>Add Document to Data Item</h3>

<EditForm Model="@document" OnValidSubmit="@HandleValidSubmit">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="form-group">
        <label for="description">Description</label>
        <InputText id="description" @bind-Value="document.Description" class="form-control" />
    </div>
    <div class="form-group">
        <label for="url">URL</label>
        <InputText id="url" @bind-Value="document.Url" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary">Create</button>
    <a href="@($"/dataitems/{id}/documents")" class="btn btn-link">Back to List</a>
</EditForm>

@code {
    [Parameter]
    public int id { get; set; }

    private Document document = new Document();

    private async Task HandleValidSubmit()
    {
        var dataItem = await _context.DataItems.Include(d => d.DocumentList).FirstOrDefaultAsync(d => d.ID == id);
        if (dataItem != null)
        {
            if (dataItem.DocumentList == null)
            {
                dataItem.DocumentList = new Models.DocumentList();
                _context.DocumentLists.Add(dataItem.DocumentList);
            }
            document.DocumentListID = dataItem.DocumentListID;
            _context.Documents.Add(document);
            await _context.SaveChangesAsync();
        }
        NavigationManager.NavigateTo($"/dataitems/{id}/documents");
    }
}