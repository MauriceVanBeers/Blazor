@page "/dataitems/{dataItemId:int}/documents/delete/{documentId:int}"

@using LinkManager.Data
@using LinkManager.Models
@inject ApplicationDbContext _context
@inject NavigationManager NavigationManager

<h3>Delete Document</h3>

@if (document == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <h4>Are you sure you want to delete this document?</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Description</dt>
        <dd class="col-sm-10">@document.Description</dd>
        <dt class="col-sm-2">URL</dt>
        <dd class="col-sm-10">@document.Url</dd>
    </dl>

    <button @onclick="Delete" class="btn btn-danger">Delete</button>
    <a href="@($"/dataitems/{dataItemId}/documents")" class="btn btn-link">Back to List</a>
}

@code {
    [Parameter]
    public int dataItemId { get; set; }

    [Parameter]
    public int documentId { get; set; }

    private Document document = null!;

    protected override async Task OnInitializedAsync()
    {
        document = await _context.Documents.FindAsync(documentId);
    }

    private async Task Delete()
    {
        _context.Documents.Remove(document);
        await _context.SaveChangesAsync();
        NavigationManager.NavigateTo($"/dataitems/{dataItemId}/documents");
    }
}